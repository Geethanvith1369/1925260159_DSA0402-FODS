        "import numpy as np\n",
        "\n",
        "# Marks of 4 students in 4 subjects\n",
        "student_scores = np.array([\n",
        "    [85, 90, 78, 88],\n",
        "    [92, 85, 80, 75],\n",
        "    [78, 88, 95, 82],\n",
        "    [90, 92, 85, 80]\n",
        "])\n",
        "\n",
        "# Calculate average score for each subject\n",
        "averages = np.mean(student_scores, axis=0)\n",
        "\n",
        "subjects = [\"Math\", \"Science\", \"English\", \"History\"]\n",
        "\n",
        "# Display averages\n",
        "for subject, avg in zip(subjects, averages):\n",
        "    print(f\"{subject} Average: {avg:.2f}\")\n",
        "\n",
        "# Find the subject with the highest average\n",
        "highest_subject = subjects[np.argmax(averages)]\n",
        "print(\"Subject with highest average:\", highest_subject)"
      ]
