        "import numpy as np\n",
        "from scipy import stats\n",
        "\n",
        "# Sample conversion rate data (in percentage)\n",
        "design_A = np.array([4.2, 4.5, 4.0, 4.8, 4.3, 4.6, 4.1, 4.4, 4.7, 4.2])\n",
        "design_B = np.array([5.1, 5.4, 5.0, 5.6, 5.2, 5.5, 5.3, 5.7, 5.1, 5.4])\n",
        "\n",
        "# Calculate mean conversion rates\n",
        "mean_A = np.mean(design_A)\n",
        "mean_B = np.mean(design_B)\n",
        "\n",
        "# Perform independent two-sample t-test\n",
        "t_stat, p_value = stats.ttest_ind(design_A, design_B)\n",
        "\n",
        "print(\"Mean Conversion Rate - Design A:\", round(mean_A, 2), \"%\")\n",
        "print(\"Mean Conversion Rate - Design B:\", round(mean_B, 2), \"%\")\n",
        "print(\"T-statistic:\", round(t_stat, 4))\n",
        "print(\"P-value:\", round(p_value, 4))\n",
        "\n",
        "# Check statistical significance\n",
        "if p_value < 0.05:\n",
        "    print(\"Result: There is a statistically significant difference.\")\n",
        "else:\n",
        "    print(\"Result: There is no statistically significant difference.\")"
