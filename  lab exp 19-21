        "import numpy as np\n",
        "import pandas as pd\n",
        "from scipy import stats\n",
        "from google.colab import files\n",
        "\n",
        "# Upload CSV file\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Read CSV file\n",
        "data = pd.read_csv(\"rare_elements.csv\").iloc[:, 0].dropna().values\n",
        "\n",
        "# Get user inputs\n",
        "n = int(input(\"Enter sample size: \"))\n",
        "confidence = float(input(\"Enter confidence level (e.g., 95): \"))\n",
        "precision = float(input(\"Enter desired precision: \"))\n",
        "\n",
        "if n < 2 or n > len(data):\n",
        "    print(\"Invalid sample size! Enter a value between 2 and\", len(data))\n",
        "else:\n",
        "    # Select random sample\n",
        "    sample = np.random.choice(data, n, replace=False)\n",
        "\n",
        "    # Point estimation\n",
        "    mean = np.mean(sample)\n",
        "    std = np.std(sample, ddof=1)\n",
        "\n",
        "    # Calculate confidence interval\n",
        "    alpha = 1 - confidence / 100\n",
        "    t_value = stats.t.ppf(1 - alpha / 2, n - 1)\n",
        "    margin = t_value * std / np.sqrt(n)\n",
        "\n",
        "    print(\"\\nPoint Estimate (Mean):\", round(mean, 4))\n",
        "    print(\"95% or Selected Confidence Interval:\",\n",
        "          (round(mean - margin, 4), round(mean + margin, 4)))\n",
        "    print(\"Margin of Error:\", round(margin, 4))\n",
        "\n",
        "    if margin <= precision:\n",
        "        print(\"Desired precision achieved.\")\n",
        "    else:\n",
        "        print(\"Desired precision not achieved.\")"
      ],
