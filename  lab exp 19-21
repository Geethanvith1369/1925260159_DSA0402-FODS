      "source": [
        "import numpy as np\n",
        "from scipy import stats\n",
        "\n",
        "# Blood pressure reduction data (sample values)\n",
        "drug = np.array([12, 15, 10, 14, 16, 13, 11, 17, 14, 15])\n",
        "placebo = np.array([5, 7, 4, 6, 8, 5, 6, 7, 4, 6])\n",
        "\n",
        "def confidence_interval(data):\n",
        "    n = len(data)\n",
        "    mean = np.mean(data)\n",
        "    std = np.std(data, ddof=1)\n",
        "    t_value = stats.t.ppf(0.975, df=n - 1)\n",
        "    margin = t_value * std / np.sqrt(n)\n",
        "\n",
        "    return mean, mean - margin, mean + margin\n",
        "\n",
        "# Calculate confidence intervals\n",
        "drug_mean, drug_low, drug_high = confidence_interval(drug)\n",
        "placebo_mean, placebo_low, placebo_high = confidence_interval(placebo)\n",
        "\n",
        "print(\"New Drug Group:\")\n",
        "print(f\"Mean reduction: {drug_mean:.2f} mmHg\")\n",
        "print(f\"95% Confidence Interval: ({drug_low:.2f}, {drug_high:.2f})\")\n",
        "\n",
        "print(\"\\nPlacebo Group:\")\n",
        "print(f\"Mean reduction: {placebo_mean:.2f} mmHg\")\n",
        "print(f\"95% Confidence Interval: ({placebo_low:.2f}, {placebo_high:.2f})\")\n"
      ],
