        "# 2. Boxplots\n",
        "df.boxplot()\n",
        "plt.title(\"Boxplots of Age and Body Fat\")\n",
        "plt.show()\n",
        "\n",
        "# 3. Scatter Plot\n",
        "plt.scatter(df['Age'], df['%Fat'])\n",
        "plt.xlabel(\"Age\")\n",
        "plt.ylabel(\"Body Fat (%)\")\n",
        "plt.title(\"Age vs Body Fat\")\n",
        "plt.show()\n",
        "\n",
        "# 4. Q-Q Plot for Age\n",
        "stats.probplot(df['Age'], dist=\"norm\", plot=plt)\n",
        "plt.title(\"Q-Q Plot of Age\")\n",
        "plt.show()\n",
        "\n",
        "# 5. Q-Q Plot for Body Fat\n",
