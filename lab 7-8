        "import pandas as pd\n",
        "\n",
        "# Create sales DataFrame\n",
        "sales_data = pd.DataFrame({\n",
        "    'product_name': ['Pen', 'Book', 'Pen', 'Bag', 'Book', 'Pencil', 'Bag'],\n",
        "    'quantity_sold': [10, 20, 15, 8, 25, 12, 18]\n",
        "})\n",
        "\n",
        "# Calculate total quantity sold for each product\n",
        "total_sales = sales_data.groupby('product_name')['quantity_sold'].sum()\n",
        "\n",
        "# Find top 5 best-selling products\n",
        "top_5 = total_sales.sort_values(ascending=False).head(5)\n",
        "\n",
        "print(\"Top 5 best-selling products:\")\n",
        "print(top_5)"
