        "import pandas as pd\n",
        "import numpy as np\n",
        "from scipy import stats\n",
        "from google.colab import files\n",
        "\n",
        "# Upload CSV file\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Read CSV data\n",
        "df = pd.read_csv(\"customer_reviews.csv\")\n",
        "\n",
        "# Extract customer ratings\n",
        "ratings = df[\"rating\"].dropna()\n",
        "\n",
        "# Calculate sample statistics\n",
        "n = len(ratings)\n",
        "mean_rating = ratings.mean()\n",
        "std_dev = ratings.std()\n",
        "\n",
        "# Calculate 95% confidence interval\n",
        "confidence = 0.95\n",
        "t_value = stats.t.ppf((1 + confidence) / 2, n - 1)\n",
        "margin_error = t_value * std_dev / np.sqrt(n)\n",
        "\n",
        "lower = mean_rating - margin_error\n",
        "upper = mean_rating + margin_error\n",
        "\n",
        "# Display results\n",
        "print(\"Number of Reviews:\", n)\n",
        "print(\"Average Rating:\", round(mean_rating, 2))\n",
        "print(\"95% Confidence Interval:\", round(lower, 2), \"to\", round(upper, 2))\n",
        "\n",
        "# Customer satisfaction level\n",
        "if mean_rating >= 4:\n",
        "    print(\"Customer Satisfaction: High\")\n",
        "elif mean_rating >= 3:\n",
        "    print(\"Customer Satisfaction: Moderate\")\n",
        "else:\n",
        "    print(\"Customer Satisfaction: Low\")"
